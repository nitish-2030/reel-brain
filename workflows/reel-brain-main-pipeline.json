    {
      "parameters": {
        "jsCode": "const caption = $json.channel_post.text || '';\n\nconst promptText = `This is an Instagram post caption or URL (the actual video content was not accessible, so work only from this caption): \"${caption}\"\n\nBased ONLY on this caption, respond ONLY in valid JSON, no markdown, in this exact shape:\n{\n  \"summary\": \"a specific summary based on what the caption says. If the caption names specific tools, apps, websites, products, or brands, list each one by its exact name as written, with a short note on what it is used for. Do not generalize named items into a category. Clearly mention that this summary is caption-only because the video was unavailable.\",\n  \"tags\": [\"tag1\", \"tag2\", \"tag3\"],\n  \"problem\": \"what problem or need this content likely addresses\",\n  \"claim\": \"if the caption states a specific factual claim, statistic, instruction, or names a tool/website/brand that could be checked or verified, state it here EXACTLY as written in the caption, preserving exact names and numbers. If there is no checkable claim, set this to null.\"\n}\n\nIf there isn't enough information in the caption, make a reasonable best guess and say so in the summary.`;\n\nconst body = {\n  contents: [\n    {\n      parts: [\n        { text: promptText }\n      ]\n    }\n  ]\n};\n\nreturn {\n  json: {\n    geminiBody: body\n  }\n};"
      },
