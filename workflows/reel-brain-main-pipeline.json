      "parameters": {
        "jsCode": "const responseText = $input.item.json.candidates[0].content.parts[0].text;\n// Clean up any markdown code fences if present\nconst cleaned = responseText.replace(/```json|```/g, '').trim();\nconst parsed = JSON.parse(cleaned);\n\nif (!parsed.claim || String(parsed.claim).trim() === '') {\n  parsed.claim = null;\n}\n\nreturn {\n  json: {\n    summary: parsed.summary,\n    tags: parsed.tags,\n    problem: parsed.problem,\n    claim: parsed.claim\n  }\n};"
